{
  "name": "@freedomofpress/webcat-cli",
  "version": "0.1.2",
  "description": "WEBCAT CLI for creating, validating, and packaging enrollments and manifests.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/freedomofpress/webcat-cli"
  },
  "type": "module",
  "bin": {
    "webcat": "dist/cli.cjs"
  },
  "files": [
    "dist/cli.cjs"
  ],
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "tsc && esbuild src/cli.ts --bundle --platform=node --format=cjs --outfile=dist/cli.cjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run tests",
    "typecheck": "tsc"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@freedomofpress/sigstore-browser": "^0.1.15",
    "@freedomofpress/sigsum": "^0.4.0",
    "@sigstore/bundle": "^5.0.0",
    "@sigstore/sign": "^5.0.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "commander": "^15.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
